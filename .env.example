# Every value below is validated before anything is built from it, and every problem is reported at
# once rather than one per restart. A misspelled number or a flag that is not exactly true/false is
# refused rather than quietly defaulted. See apps/api/src/config/environment.ts and docs/deployment.md.
PORT=4000
# The browser origins allowed to send credentialed requests. Required in production, and https outside
# local development: session cookies only travel to an origin named here. Comma-separate two during a
# cutover between hostnames. It is an origin, not a URL — a path is refused, because the browser never
# sends one and `https://host/app` would silently grant the whole host.
WEB_ORIGIN=https://huddle.example.com
# --- League synchronization (see docs/league-sync.md) ---
# How often the worker sweeps every connected league, and the base for each league's next attempt.
SYNC_INTERVAL_MINUTES=30
# Whether this process runs the schedule. One worker owns it: set false on every instance except the
# worker or managed job in a multi-instance deployment. The sweep lease is the safety net if you don't.
SYNC_WORKER_ENABLED=true
# Lease owner identity. Defaults to host:pid:random; name it explicitly for a managed job.
# SYNC_WORKER_ID=
# The worker serves no application traffic, so an orchestrator has nothing to ask it. Naming a port
# gives it a liveness probe on /health; leaving it unset binds nothing. Only the worker reads this.
# WORKER_HEALTH_PORT=4010
# Leagues synchronized at once. Each one is up to seven Sleeper calls, so this is the number that
# decides how hard a large installation leans on a free shared API.
SYNC_CONCURRENCY=3
# Upper bound on the random offset before each attempt, so a restart does not fire every league at once.
SYNC_JITTER_SECONDS=20
# Backoff after a failure that carried no Retry-After. Upstream's own guidance always wins over these.
SYNC_RETRY_BASE_SECONDS=60
SYNC_RETRY_MAX_MINUTES=60
# Lease lifetime. It is renewed while a sweep works through its queue, and expires on a killed worker.
SYNC_LEASE_MINUTES=10
# Retention. A finished season stops being scheduled this long after its last successful sync, keeping
# all of its data; an archived league is deleted only after this second window AND only once no account
# links it any more.
SYNC_ARCHIVE_AFTER_DAYS=30
SYNC_PRUNE_AFTER_DAYS=180
# --- Storage (see docs/storage.md) ---
# Which adapter this process talks to: json or postgres. Required in production, where a deployment
# that silently fell back to a file because a variable was missing is the failure this refuses.
STORAGE_ADAPTER=json
# How many instances share this storage: single or multi. When unset, an instance that has been told
# another owns the schedule (SYNC_WORKER_ENABLED=false) is treated as one of several in production.
# The json adapter is refused for a multi-instance production deployment: its writes are atomic only
# within one process, so instances overwrite each other and both take the same lease.
APP_INSTANCE_MODE=single
# Where the json adapter keeps its document. Mount it on persistent storage in a container.
DATA_FILE=../../data/store.json
# Required by STORAGE_ADAPTER=postgres. A secret: inject it, never commit it. Apply apps/api/migrations
# before starting, and read docs/data-durability.md before the first one stores user data.
# DATABASE_URL=postgres://huddle@localhost:5432/huddle
# One of development, test or production. Every production safeguard in this application is an exact
# comparison against 'production', so 'prod' is refused rather than treated as production-ish.
NODE_ENV=development
# How long shutdown waits for in-flight requests, synchronizations and ingestion before the process
# exits anyway. Set the orchestrator's termination grace period above this, or it will kill the process
# part-way through its own drain.
SHUTDOWN_GRACE_SECONDS=20
# What sits in front of the API. Rate limits are charged to the client address, which is only the real
# client once this matches the deployment — and both ways of getting it wrong are silent. Too low and
# every client shares one bucket; too high and Express reads the part of X-Forwarded-For the client
# wrote, so a caller picks their own address. Set the number of proxies (1 behind a load balancer), a
# comma-separated list of their addresses/subnets, or exactly `false` for an API exposed directly.
# Production requires one of those explicitly and refuses `true`, which believes the whole chain.
TRUST_PROXY=false
# How long this process will wait on somebody else's server. Each profile is a whole budget — one
# attempt's timeout, the attempt count, and the total across every attempt and backoff — because
# bounding an attempt does not bound their sum. See apps/api/src/config/upstream.ts.
# The interactive profile: a browser is blocked on it, so keep the total under SHUTDOWN_GRACE_SECONDS.
UPSTREAM_TIMEOUT_SECONDS=10
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_REQUEST_BUDGET_SECONDS=20
# The background profile: the worker's ingestion window, where nobody is waiting.
UPSTREAM_BACKGROUND_BUDGET_SECONDS=90
# The floor for this process's own logging: debug, info, warn, error, or silent. Logs are one JSON
# object per line with session material, provider credentials, filesystem paths and personal settings
# removed on the way out; see docs/deployment.md.
LOG_LEVEL=info
# Generate this value with: npm run password-hash -w @sleeper/api -- 'a-long-unique-password'
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD_HASH=
# Absolute session lifetime. Rotation never extends it; signing in again is the only way past it.
SESSION_TTL_HOURS=24
# Idle window. Each authenticated request moves it forward, capped by SESSION_TTL_HOURS.
SESSION_IDLE_MINUTES=120
# How often a live session is issued a new id. The retired id stays usable for the grace window below so
# requests already in flight do not fail; replaying it after that revokes the whole session family.
SESSION_ROTATE_MINUTES=30
SESSION_ROTATION_GRACE_SECONDS=60
# Development only. The API refuses to start with this enabled in production.
ENABLE_DEMO_AUTH=false
# Development only, and refused in production. Drops the __Host- prefix and Secure attribute so sign-in
# works over plain http on a machine without TLS. Never enable it on a shared or reachable host.
INSECURE_DEV_COOKIES=false
# Optional trusted raw-stat forecast JSON shared by waivers and trades. Absolute: a relative path is
# read against the working directory, which differs between a development shell and a container.
# WAIVER_SIGNALS_PATH=/absolute/path/to/waiver-signals.json

# --- Licensed projection and injury feed (opt-in) ---
# Off unless PROJECTION_FEED_ENABLED=true. When off, no credential is read and the WAIVER_SIGNALS_PATH
# file adapter above continues to serve forecasts unchanged. See docs/projection-provider.md.
PROJECTION_FEED_ENABLED=false
# SportsDataIO subscription key. Sent as a request header, never in a query string. Required when the
# feed is enabled; the process refuses to start without it rather than publishing an empty feed.
# Given to the WORKER only: it is the one process that calls the source. An API instance reads the feed
# the worker retained and has no use for a key. See docs/deployment.md.
# SPORTSDATAIO_API_KEY=
# PROJECTION_FEED_PATH=../../data/projection-feed.json
# How old the retained feed may be before reads treat it as stale. The last good feed is always kept;
# past this age it stops answering requests and the engines report an explicit unavailable state.
PROJECTION_FEED_STALE_HOURS=12
# How old the *source's own* timestamp may be. A source that stops publishing keeps answering 200 with
# an old timestamp, so this is the only threshold that catches it.
PROJECTION_FEED_MAX_SOURCE_AGE_HOURS=6
# Fraction of source players that must resolve to a Sleeper id. An unmatched player is silently absent
# from every ranking, so this is alerted rather than tolerated.
PROJECTION_FEED_MIN_IDENTITY_MATCH=0.95
# A volume floor: a source returning far fewer players than a roster-wide feed needs is an outage.
PROJECTION_FEED_MIN_PLAYERS=300
# When true, any category the live league scores and the feed omits is a critical breach, not a warning.
PROJECTION_FEED_REQUIRE_COMPLETE_COVERAGE=false
# Optional operations webhook. Console alerting is always on and is never disabled by this.
# PROJECTION_FEED_ALERT_WEBHOOK=
# Ingestion windows are interpreted here, because the NFL week is defined in Eastern time.
PROJECTION_FEED_TIME_ZONE=America/New_York
# Both default to the current season and the week anchored to the Tuesday of Labor Day week.
# NFL_SEASON=
# NFL_WEEK_ONE_TUESDAY=
