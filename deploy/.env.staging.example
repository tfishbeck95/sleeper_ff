# Staging values. Copy to `deploy/.env.staging` and fill in.
#
#   docker compose --env-file .env.staging -f compose.yaml -f compose.staging.yaml up --build
#
# Everything below is staging's own. Nothing is shared with production — not the database, not the
# credentials, not the leagues, not the forecast subscription. `compose.staging.yaml` explains why for
# each of them.

# The project name is what separates the volumes, the network and the container names, so the two
# stacks can run on one machine and staging cannot open production's database by accident.
COMPOSE_PROJECT_NAME=huddle-staging

# --- Database ---------------------------------------------------------------------------------
# A separate database with separate credentials, not a schema inside production's server. A rollback
# rehearsal drops tables, and a connection string that differs only by a search path is one typo away
# from dropping the wrong ones.
POSTGRES_USER=huddle_staging
POSTGRES_DB=huddle_staging
POSTGRES_PASSWORD=

# --- Application sign-in ----------------------------------------------------------------------
# A separate login and a separate hash. Sharing production's would make a staging compromise a
# production one: it is the same credential class, opening every league the account links.
# Generate with: npm run password-hash -w @sleeper/api -- 'a-different-long-unique-password'
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD_HASH=

# --- Origins ----------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:8180
VITE_API_URL=http://localhost:4100
API_ORIGIN=http://localhost:4100

# --- Published ports --------------------------------------------------------------------------
# Shifted so staging and production can run side by side.
API_PORT=4100
WEB_PORT=8180

# --- Leagues ------------------------------------------------------------------------------------
# There is no variable for this: league connections follow the Sleeper account linked through the
# dashboard, and they live in this environment's own database. Sign in to staging and link a league
# created for testing — not the one a real season depends on. Sleeper is a free shared API and each
# connected league is up to seven calls per sweep, and staging runs unreleased synchronization code,
# which is exactly the code that should not be writing the snapshot someone sets a lineup from.

# --- Licensed forecast feed ---------------------------------------------------------------------
# Off, and pinned off in compose.staging.yaml: staging does not spend a licensed subscription's quota.
# It runs with forecasts reported unavailable, or on a WAIVER_SIGNALS_PATH fixture — both states the
# dashboard has to render correctly anyway.
PROJECTION_FEED_ENABLED=false
SPORTSDATAIO_API_KEY=
