# Values for the Compose stack in this directory. Copy to `deploy/.env` and fill in.
#
#   cp .env.example .env && $EDITOR .env && docker compose up --build
#
# `deploy/.env` is ignored by git and excluded from every build context, so nothing here reaches an
# image layer. Compose reads it on the host and passes each value to the one service that needs it —
# `compose.yaml` names them service by service, which is also where to look for which component holds
# which secret. docs/deployment.md has the same thing as a table.
#
# In a real deployment these come from the platform's secret store rather than a file. Which component
# gets which value does not change.

# --- Database ---------------------------------------------------------------------------------
# Used by: postgres (creates the role), migrate and api and worker (through DATABASE_URL).
POSTGRES_USER=huddle
POSTGRES_DB=huddle
# Secret. No default: the stack refuses to start without one rather than shipping a known password.
POSTGRES_PASSWORD=

# --- Application sign-in ----------------------------------------------------------------------
# Used by: api. The worker never authenticates anyone and is not given these.
APP_LOGIN_USER=admin
# Secret, and the only credential that opens every league the account links.
# Generate with: npm run password-hash -w @sleeper/api -- 'a-long-unique-password'
APP_LOGIN_PASSWORD_HASH=
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=120

# --- Origins ----------------------------------------------------------------------------------
# Used by: api. The exact browser origins allowed to send credentialed requests; comma-separate two
# during a cutover. https outside local development — a session cookie only travels to an origin here.
WEB_ORIGIN=http://localhost:8080
# Used by: web, at build time. Substituted into the bundle, so one build serves one environment. Leave
# empty when the API is reverse-proxied onto the dashboard's own origin, which is what the __Host-
# prefixed, SameSite=Strict session cookie wants.
VITE_API_URL=http://localhost:4000
# Used by: web, at container start. What the page's Content-Security-Policy allows it to connect to.
API_ORIGIN=http://localhost:4000

# --- Published ports --------------------------------------------------------------------------
# Only these are published. PostgreSQL is reachable from the stack's network and nowhere else.
API_PORT=4000
WEB_PORT=8080

# --- Synchronization --------------------------------------------------------------------------
# Used by: worker. The API instances are told they do not own the schedule; see SYNC_WORKER_ENABLED
# in compose.yaml.
SYNC_INTERVAL_MINUTES=30
SYNC_CONCURRENCY=3

# --- Licensed forecast feed (opt-in) ----------------------------------------------------------
# Used by: worker for ingestion, api for reading the retained feed. Off unless this is `true`, in which
# case SPORTSDATAIO_API_KEY is required and the process refuses to start without it.
PROJECTION_FEED_ENABLED=false
# Secret. Given to the worker only: it is the one component that calls the source. The API reads what
# the worker retained and has no use for a key.
SPORTSDATAIO_API_KEY=
PROJECTION_FEED_TIME_ZONE=America/New_York
